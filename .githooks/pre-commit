#!/bin/sh
# Blocks commits containing secrets or secret-like files. Enabled by: git config core.hooksPath .githooks
branch=$(git symbolic-ref --short HEAD 2>/dev/null)
if [ "$branch" = "main" ]; then
  echo "pre-commit: direct commits to main are not allowed (use a sprint/* branch)." >&2
  exit 1
fi
exec node tools/scan-secrets.mjs --staged
